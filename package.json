{
  "name": "ai-teacher",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "apps": "node scripts/apps.mjs",
    "apps:plain": "pnpm --parallel --filter @senoy/web --filter @senoy/api --filter @senoy/worker --filter @senoy/console dev",
    "dash": "pnpm --filter @senoy/console dev",
    "check": "pnpm typecheck && pnpm test",
    "test:e2e": "pnpm --filter @senoy/e2e test",
    "typecheck": "pnpm --filter @senoy/db --filter @senoy/research --filter @senoy/api --filter @senoy/worker --filter @senoy/web --filter @senoy/e2e exec tsc --noEmit && pnpm --filter @senoy/console typecheck",
    "test": "pnpm --filter @senoy/db exec tsx --test src/*.test.ts && pnpm --filter @senoy/research exec tsx --test src/*.test.ts && pnpm --filter @senoy/api exec tsx --test src/routes/*.test.ts src/lib/*.test.ts && pnpm --filter @senoy/console exec tsx --test src/server/*.test.ts",
    "check:course-requests:live": "pnpm --filter @senoy/api exec tsx src/routes/course-requests.live-check.ts",
    "check:blueprint:live": "pnpm --filter @senoy/api exec tsx src/routes/blueprint.live-check.ts",
    "check:starting-level:live": "pnpm --filter @senoy/api exec tsx src/routes/starting-level.live-check.ts",
    "check:reading:live": "pnpm --filter @senoy/api exec tsx src/lib/reading-generation.live-check.ts",
    "check:quiz:live": "pnpm --filter @senoy/api exec tsx src/lib/quiz-generation.live-check.ts",
    "check:research:live": "pnpm --filter @senoy/research exec tsx src/research.live-check.ts",
    "check:goal-focus-blueprint:live": "pnpm --filter @senoy/api exec tsx src/lib/goal-focus-blueprint.live-check.ts",
    "check:validity:live": "pnpm --filter @senoy/api exec tsx src/routes/validity.live-check.ts",
    "check:goal-focus:live": "pnpm --filter @senoy/api exec tsx src/routes/goal-focus.live-check.ts",
    "db:generate": "pnpm --filter @senoy/db generate",
    "db:migrate": "pnpm --filter @senoy/db migrate",
    "db:seed": "pnpm --filter @senoy/db seed",
    "parallel:login": "pnpm --filter @senoy/research exec tsx src/parallel-login.ts",
    "openrouter:import": "pnpm --filter @senoy/console exec tsx src/server/import-openrouter-history.ts"
  }
}
