DATABASE_URL=
# The shared (Supabase) database live checks record their Usage Records in, while DATABASE_URL points at a local one.
# Required by every pnpm check:*:live script; a localhost URL is refused.
USAGE_DATABASE_URL=
MEDIA_BUCKET=
# The bucket's S3 endpoint and signing region, from Supabase → Storage → S3 connection:
# https://<project-ref>.storage.supabase.co/storage/v1/s3 and the project's region.
MEDIA_ENDPOINT=
MEDIA_REGION=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
OPENROUTER_API_KEY=
GENERATOR_MODEL=
GENERATOR_FALLBACK_MODEL=
LESSON_GENERATOR_MODEL=
LESSON_GENERATOR_FALLBACK_MODEL=
JUDGE_MODEL=
JUDGE_FALLBACK_MODEL=
PARALLEL_PRO_API_KEY=
YOU_DOT_COM_API_KEY=
PRIMARY_RESEARCH_ADAPTER=parallel-pro
SECONDARY_RESEARCH_ADAPTER=you-research
APP_URL=http://localhost:3000

# Whose generation jobs this stack queues and claims on the shared database. Defaults to the Railway environment id on
# Railway, else this machine's hostname. Set the same value on an API and worker that run on different hosts elsewhere (ADR 0024).
JOB_OWNER=

# Usage Console (apps/console). Its API listens here; the screen is on 5174.
CONSOLE_API_PORT=3100
